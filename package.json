{
  "name": "doubtful-memory",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "A project brain that knows when it might be wrong — local-first memory auditing for AI coding agents",
  "bin": {
    "gptbrain": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/test/**/*.test.js",
    "verify": "npm run typecheck && npm run build && npm run test",
    "gptbrain": "node dist/src/cli.js",
    "benchmark": "npm run build && node dist/src/benchmark/generate.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "6.0.3"
  }
}
