{
  "name": "tamhees",
  "version": "1.0.0-rc.2",
  "private": true,
  "type": "module",
  "description": "Memory under scrutiny. Local-first project-memory auditing for AI coding agents.",
  "keywords": [
    "ai-agents",
    "agent-memory",
    "coding-agents",
    "mcp",
    "memory-audit",
    "local-first"
  ],
  "homepage": "https://weweb12.github.io/tamhees/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weweb12/tamhees.git"
  },
  "author": "weweb12",
  "bin": {
    "tamhees": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc && node dist/src/dashboard/copy-assets.js",
    "prepare": "node scripts/check-build-tools.mjs && npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/test/**/*.test.js",
    "verify": "npm run typecheck && npm run build && npm run test",
    "verify:dashboard": "npm run typecheck && npm run build && node --test dist/test/dashboard.test.js",
    "dashboard": "npm run build && node dist/src/dashboard/server.js",
    "tamhees": "node dist/src/cli.js",
    "benchmark": "npm run build && node dist/src/benchmark/generate.js",
    "failure-test": "npm run build && node scripts/failure-test.mjs",
    "site": "npm run build && node scripts/build-static-site.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "6.0.3"
  }
}
